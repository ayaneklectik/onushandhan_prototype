FROM nginx:1.27-alpine

COPY nginx/default.conf /etc/nginx/conf.d/default.conf
COPY index.html article.html admin.html maintenance.html styles.css admin.css app.js admin.js article.js content.js onusondhan-logo.png /usr/share/nginx/html/
COPY test-assets /usr/share/nginx/html/test-assets

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1/healthz || exit 1
